<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>felix_bringup</name>
  <version>0.1.0</version>
  <description>
    Top-level launch composition and parameters for the Felix robot. Brings up
    the felix_base driver stack today; future subsystems (description, slam,
    perception, streaming) get composed in here too.
  </description>
  <maintainer email="kevin.williams@sidusa.com">Kevin Williams</maintainer>
  <license>Proprietary</license>

  <exec_depend>felix_base</exec_depend>
  <exec_depend>felix_localization</exec_depend>
  <exec_depend>felix_description</exec_depend>
  <exec_depend>felix_slam</exec_depend>
  <exec_depend>felix_nav</exec_depend>
  <exec_depend>felix_camera</exec_depend>
  <exec_depend>foxglove_bridge</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
