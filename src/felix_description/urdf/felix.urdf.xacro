<?xml version="1.0"?>
<!--
  Felix mecanum chassis description.

  TF tree:  base_link -> base_footprint   (ground projection, below)
                      -> imu_link
                      -> laser
                      -> camera_link -> camera_optical_link  (REP-105 optical, z fwd)

  base_link is the URDF ROOT and the chassis rotation centre (the point the EKF
  publishes odom -> base_link for). Everything else, including base_footprint (the
  ground projection), hangs off it, so base_link has exactly one parent (odom),
  not two. robot_state_publisher turns the fixed joints below into /tf_static, which
  is what the EKF (base_link -> imu_link) and SLAM (base_link -> laser) consume; this
  replaces the temporary static_transform_publisher that bringup used before.

  >>> EDIT THE MOUNT OFFSETS BELOW TO YOUR MEASURED VALUES <<<
  All offsets are in metres / radians, in REP-103 base_link axes:
    x = forward, y = left, z = up; yaw +ve = counter-clockwise (from above).
-->
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="felix">

  <!-- ===================== Tunable geometry ===================== -->
  <!-- Chassis box (visual only; from config.yml geometry, approx). -->
  <xacro:property name="base_len"   value="0.22"/>   <!-- x, front<->rear -->
  <xacro:property name="base_width" value="0.28"/>   <!-- y, left<->right -->
  <xacro:property name="base_height" value="0.08"/>  <!-- z, chassis thickness -->
  <xacro:property name="wheel_radius" value="0.0485"/> <!-- base_link height above ground -->

  <!-- LASER (RPLIDAR) mount, base_link -> laser.  TODO: MEASURE THESE. -->
  <!-- x/y/z = lidar centre offset from base_link; yaw = rotation of the lidar's
       0-degree ray relative to robot forward (+x). If the scan appears rotated
       in rviz/the map, adjust laser_yaw (RPLIDAR zero often faces the cable). -->
  <!-- laser_x measured 2026-06-08: 2.5 in = 0.0635 m, the forward distance from
       base_link's origin (chassis rotation centre) to the lidar's scan-centre axis.
       centred (laser_y = 0); beam 0.115 m above floor, so laser_z = 0.115 -
       wheel_radius relative to base_link (axle height).
       laser_yaw = 0: the RPLIDAR was physically re-oriented 2026-06-08 so its
       zero-ray faces FORWARD (+x), so no yaw correction is needed. (Previously it
       was mounted rotated 180deg with the zero-ray facing backward, which needed
       laser_yaw = pi.) -->
  <xacro:property name="laser_x"   value="0.0635"/>
  <xacro:property name="laser_y"   value="0.0"/>
  <xacro:property name="laser_z"   value="0.0665"/>
  <xacro:property name="laser_yaw" value="0.0"/>

  <!-- IMU mount, base_link -> imu_link.  Identity: the EKF only fuses gyro
       yaw-rate, which is invariant to rotation about the shared z-axis, so this
       does not affect localisation. IMU re-mounted x-forward + centered (2026-06).
       The raw gyro-Z is board-intrinsically inverted vs REP-103 and is corrected
       in bridge_node._publish_imu (not here). Accel is published raw and unfused;
       encode real roll/pitch/yaw here only if/when you start fusing acceleration. -->
  <xacro:property name="imu_x"     value="0.0"/>
  <xacro:property name="imu_y"     value="0.0"/>
  <xacro:property name="imu_z"     value="0.0"/>
  <xacro:property name="imu_roll"  value="0.0"/>
  <xacro:property name="imu_pitch" value="0.0"/>
  <xacro:property name="imu_yaw"   value="0.0"/>

  <!-- CAMERA mount, base_link -> camera_link.  Measured 2026-06-08:
       horizontally centred (y=0). z=0: the camera centre is wheel_radius
       (0.0485 m) above the ground, which is exactly base_link's height (axle
       height), so the offset relative to base_link is zero.
       x: the camera base sits ~10 mm behind the front-most point of the front
       wheels. Front axle = wheel_base/2 = 0.095 m forward; front-most wheel point
       = 0.095 + wheel_radius (0.0485) = 0.1435 m; minus 0.010 = 0.1335 m.
       Orientation is REP-103 (x forward) like base_link; the REP-105 optical
       frame (z forward, x right, y down) is published as camera_optical_link,
       a fixed child of camera_link (below). felix_perception stamps CameraInfo
       and Detection2DArray in camera_optical_link, not camera_link. -->
  <xacro:property name="camera_x"     value="0.1335"/>
  <xacro:property name="camera_y"     value="0.0"/>
  <xacro:property name="camera_z"     value="0.0"/>
  <xacro:property name="camera_roll"  value="0.0"/>
  <xacro:property name="camera_pitch" value="0.0"/>
  <xacro:property name="camera_yaw"   value="0.0"/>

  <!-- ===================== Materials ===================== -->
  <material name="felix_grey"><color rgba="0.25 0.27 0.30 1.0"/></material>
  <material name="felix_black"><color rgba="0.05 0.05 0.05 1.0"/></material>

  <!-- ===================== Links & joints ===================== -->
  <!-- Ground-projection frame. Nav2 and SLAM commonly reference this. -->
  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="${base_len} ${base_width} ${base_height}"/></geometry>
      <material name="felix_grey"/>
    </visual>
  </link>

  <!-- base_footprint is a CHILD of base_link, not its parent: the EKF publishes
       odom -> base_link, so base_link is the tree node odom drives. If base_footprint
       parented base_link here, base_link would have two parents (odom + base_footprint),
       an illegal TF tree that places the body and the sensors via different paths
       (body mirrors/drifts away from the laser). base_footprint is the ground
       projection, so it sits wheel_radius BELOW base_link. -->
  <joint name="base_link_to_base_footprint" type="fixed">
    <parent link="base_link"/>
    <child link="base_footprint"/>
    <origin xyz="0 0 ${-wheel_radius}" rpy="0 0 0"/>
  </joint>

  <link name="imu_link"/>
  <joint name="base_link_to_imu" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="${imu_x} ${imu_y} ${imu_z}" rpy="${imu_roll} ${imu_pitch} ${imu_yaw}"/>
  </joint>

  <link name="laser">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.035" length="0.04"/></geometry>
      <material name="felix_black"/>
    </visual>
  </link>
  <joint name="base_link_to_laser" type="fixed">
    <parent link="base_link"/>
    <child link="laser"/>
    <origin xyz="${laser_x} ${laser_y} ${laser_z}" rpy="0 0 ${laser_yaw}"/>
  </joint>

  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.025 0.09 0.025"/></geometry>
      <material name="felix_black"/>
    </visual>
  </link>
  <joint name="base_link_to_camera" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="${camera_x} ${camera_y} ${camera_z}"
            rpy="${camera_roll} ${camera_pitch} ${camera_yaw}"/>
  </joint>

  <!-- REP-105 optical frame: z forward, x right, y down. Standard REP-103
       (x forward) -> optical rotation is rpy = (-pi/2, 0, -pi/2). felix_perception
       back-projects pixels and stamps detections/CameraInfo in this frame; the
       fusion node transforms the bearing wedge camera_optical_link -> laser. -->
  <link name="camera_optical_link"/>
  <joint name="camera_to_camera_optical" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_link"/>
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>

</robot>
