<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>felix_llm</name>
  <version>0.1.0</version>
  <description>
    Natural-language navigation: teach named rooms/areas on the map, then ask a
    LOCAL LLM (Nemotron via llama.cpp llama-server, OpenAI-compatible) to drive
    there. The agent node turns "go to the kitchen" into a NavigateToPose goal
    through Nav2 (so motion stays inside Nav2's costmaps -- no raw /cmd_vel).
  </description>
  <maintainer email="kevin.williams@sidusa.com">Kevin Williams</maintainer>
  <license>Proprietary</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>vision_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <!-- llama-server is reached over HTTP via the Python stdlib (urllib); no dep. -->
  <!-- The optional MCP server (felix_llm mcp) needs the `mcp` pip package
       (pip install mcp); it is not a rosdep key, so install it by hand. -->


  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
