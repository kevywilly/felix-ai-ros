<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>felix_nav</name>
  <version>0.1.0</version>
  <description>
    Autonomous navigation for Felix: the nav2 navigation servers (planner,
    MPPI controller, behaviors, BT navigator) on top of AMCL localization
    (felix_slam) and the EKF (felix_localization). Holonomic config -- MPPI
    uses the mecanum chassis's strafing. Assumes a map is already being served
    and localized (felix_bringup localization.launch.py).
  </description>
  <maintainer email="kevin.williams@sidusa.com">Kevin Williams</maintainer>
  <license>Proprietary</license>

  <exec_depend>nav2_controller</exec_depend>
  <exec_depend>nav2_mppi_controller</exec_depend>
  <exec_depend>nav2_planner</exec_depend>
  <exec_depend>nav2_navfn_planner</exec_depend>
  <exec_depend>nav2_behaviors</exec_depend>
  <exec_depend>nav2_bt_navigator</exec_depend>
  <exec_depend>nav2_costmap_2d</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
